# Lightweight image for free tiers (Render, Koyeb...): Tesseract engine,
# no PaddleOCR — fits in 512MB RAM. Lower accuracy than the Paddle path.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-ara \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-lite.txt .
RUN pip install --no-cache-dir -r requirements-lite.txt

COPY . .

ENV OCR_ENGINE=tesseract OCR_DPI=200 OCR_GRAYSCALE=1 OMP_THREAD_LIMIT=1 \
    HUB_MODE=1 HOST=0.0.0.0 PORT=8000 PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "run.py"]
